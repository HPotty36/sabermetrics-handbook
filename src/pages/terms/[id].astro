---
import Formula from '../../components/Formula.astro';
import LadderName from '../../components/LadderName.astro';
import LadderSteps from '../../components/LadderSteps.astro';
import Scale from '../../components/Scale.astro';
import Sec from '../../components/Sec.astro';
import Base from '../../layouts/Base.astro';
import { fmt } from '../../lib/format.ts';
import { loadHandbook, subName } from '../../lib/handbook.ts';
import { ladderPlaces } from '../../lib/ladder.ts';
import { homeHref, termHref } from '../../lib/paths.ts';
import { LEVELS } from '../../lib/schema.ts';
import { SITE_NAME } from '../../lib/site.ts';

export async function getStaticPaths() {
  const { terms } = await loadHandbook();
  return terms.map((t) => ({ params: { id: t.id } }));
}

const { termMap, ladders } = await loadHandbook();
const t = termMap.get(Astro.params.id)!;
const places = ladderPlaces(ladders, t.id);
---
<Base title={`${t.abbr} · ${t.ko} | ${SITE_NAME}`} description={t.summary} view="term" current={t.id}>
  <a class="back" href={homeHref}>← 차례</a>
  {/* 책의 본문 단과 여백 단. 넓은 화면에서는 Tufte CSS처럼 평균·사다리·같이 보기를 오른쪽 여백에 적는다. */}
  <div class="leaf">
    <article class="text">
      <header class="term-head">
        <p class="kicker"><span>{LEVELS[t.level]}</span><span>{t.cats.join(' · ')}</span>{t.added && <span>{t.added}년에 생김</span>}{places.map(({ ladder, pos, total }) => (
          <a href="#ladders">사다리 ‘{ladder.name}’ {pos}/{total}</a>
        ))}</p>
        <h1 class="headword">{t.abbr}</h1>
        <p class="names"><span class="names-ko">{t.ko}</span>{t.en !== t.abbr && t.en !== t.ko && <span class="names-en" lang="en">{t.en}</span>}</p>
        <p class="def"><span class="def-label">뜻</span>{t.summary}</p>
        {t.scale?.avg && <p class="avg-inline"><b>{fmt(t.scale.avg.v, t.scale)}</b>{t.scale.avg.t}</p>}
        <p class="toggles order-row" role="group" aria-label="읽는 순서"><span class="toggles-label">읽는 순서</span><button type="button" data-order="easy" aria-pressed="true">쉽게 먼저</button><button type="button" data-order="deep" aria-pressed="false">깊게 먼저</button></p>
      </header>

      <div data-reading-order>
        <Sec title="쉽게 말하면" data-block="easy">{t.easy.map((p) => <p>{p}</p>)}</Sec>
        {t.scale && <Sec title="숫자 읽는 법" data-block="scale"><Scale scale={t.scale} /></Sec>}
        <Sec title="깊게 보면" data-block="deep">{t.formula && <Formula formula={t.formula} />}{t.deep.map((p) => <p>{p}</p>)}</Sec>
      </div>
  {/* 읽는 순서: 첫 화면이 그려지기 전에 저장된 순서로 바꿔 두려고 인라인으로 바로 실행한다. */}
  <script is:inline>
    (function () {
      var KEY = 'sh-order';
      var body = document.querySelector('[data-reading-order]');
      var buttons = document.querySelectorAll('[data-order]');
      function saved() {
        try { return localStorage.getItem(KEY) === 'deep'; } catch (e) { return false; }
      }
      function apply(deepFirst) {
        (deepFirst ? ['deep', 'scale', 'easy'] : ['easy', 'scale', 'deep']).forEach(function (k) {
          var el = body.querySelector('[data-block="' + k + '"]');
          if (el) body.appendChild(el);
        });
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', String((b.getAttribute('data-order') === 'deep') === deepFirst));
        });
      }
      if (saved()) apply(true);
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          var deepFirst = b.getAttribute('data-order') === 'deep';
          try { localStorage.setItem(KEY, deepFirst ? 'deep' : 'easy'); } catch (e) {}
          var y = window.scrollY;
          apply(deepFirst);
          window.scrollTo(0, y);
        });
      });
      window.addEventListener('pageshow', function (e) { if (e.persisted) apply(saved()); });
    })();
  </script>

      <Sec title="흔한 오해"><blockquote class="myth"><p>“{t.myth.claim}”</p></blockquote><p>{t.myth.truth}</p></Sec>
      {t.leagues && t.leagues.length > 0 && (
        <Sec title="리그마다 다른 점">{t.leagues.map((l) => <p><b class="lg">{l.lg}</b>{l.t}</p>)}</Sec>
      )}
      <Sec title="출처"><ol class="sources">{t.sources.map((s) => <li><a href={s.u} target="_blank" rel="noopener">{s.t}</a></li>)}</ol></Sec>
    </article>

    <aside class="margin" aria-label="곁들여 볼 것">
      {t.scale?.avg && (
        <div class="mnote mnote-avg"><p class="mnote-title">평균</p><p class="avg-num">{fmt(t.scale.avg.v, t.scale)}</p><p class="mnote-small">{t.scale.avg.t}</p></div>
      )}
      {/* 사다리: GOV.UK step by step처럼 번호를 세로선으로 잇고 지금 용어를 칠한다. 앞뒤 칸이 다 보이므로 이전·다음 링크는 따로 두지 않는다. */}
      {places.length > 0 && (
        <div class="mnote" id="ladders">{places.map(({ ladder }) => (
          <div class="term-ladder"><p class="mnote-title">사다리</p><LadderName ladder={ladder} /><LadderSteps ladder={ladder} current={t.id} /></div>
        ))}</div>
      )}
      <div class="mnote"><p class="mnote-title">같이 보기</p><ul class="see-also">{t.related.map((id) => {
        const r = termMap.get(id)!;
        return <li><a href={termHref(id)}>{r.chip}</a><span>{subName(r)}</span></li>;
      })}</ul></div>
    </aside>
  </div>
</Base>
