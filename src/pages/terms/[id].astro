---
import Formula from '../../components/Formula.astro';
import LadderLine from '../../components/LadderLine.astro';
import Scale from '../../components/Scale.astro';
import Seam from '../../components/Seam.astro';
import Sec from '../../components/Sec.astro';
import Base from '../../layouts/Base.astro';
import { fmt } from '../../lib/format.ts';
import { loadHandbook, subName } from '../../lib/handbook.ts';
import { ladderPlaces } from '../../lib/ladder.ts';
import { termHref } from '../../lib/paths.ts';
import { LEVELS } from '../../lib/schema.ts';
import { SITE_NAME } from '../../lib/site.ts';
import type { NextStop } from '../../lib/stop.ts';

export async function getStaticPaths() {
  const { terms } = await loadHandbook();
  return terms.map((t) => ({ params: { id: t.id } }));
}

const { termMap, ladders } = await loadHandbook();
const t = termMap.get(Astro.params.id)!;
const places = ladderPlaces(ladders, t.id);
// 사다리마다 바로 다음 용어. 폰에서는 첫 번째를 아래쪽 알약 위에, 넓은 화면에서는 모두 본문 끝에 둔다.
const nexts: NextStop[] = places.flatMap(({ ladder, pos }) => {
  const n = termMap.get(ladder.steps[pos] ?? '');
  return n ? [{ href: termHref(n.id), name: n.chip, sub: subName(n), ladder: ladder.name }] : [];
});
// 같이 보기에는 사다리에 이미 보이는 용어를 다시 적지 않는다.
const inLadders = new Set(places.flatMap(({ ladder }) => ladder.steps));
const related = t.related.filter((id) => !inLadders.has(id)).map((id) => termMap.get(id)!);
---
<Base title={`${t.abbr} · ${t.ko} | ${SITE_NAME}`} description={t.summary} view="term" tab="terms" next={nexts[0]}>
  {/* 책의 본문 단과 여백 단. 넓은 화면에서는 Tufte CSS처럼 평균·같이 보기를 오른쪽 여백에 적는다. 좁은 화면에서는 본문 다음, 출처 앞에 온다. */}
  <div class="leaf">
    <article class="text">
      {/* 맨 위: 이 용어가 들어 있는 사다리. 지금 용어가 빨간 점이다. */}
      {places.map(({ ladder, pos, total }) => (
        <nav class="strip" aria-label={`사다리 ‘${ladder.name}’, ${total}칸 중 ${pos}번째`}>
          <p class="strip-label"><span>사다리 <b>{ladder.name}</b></span><span>{pos} / {total}</span></p>
          <LadderLine ladder={ladder} dir="h" current={t.id} />
        </nav>
      ))}
      <header class="term-head">
        <p class="kicker"><span>{LEVELS[t.level]}</span><span>{t.cats.join(' · ')}</span>{t.added && <span>{t.added}년 도입</span>}</p>
        <h1 class="headword">{t.abbr}</h1>
        <p class="names"><span class="names-ko">{t.ko}</span>{t.en !== t.abbr && t.en !== t.ko && <span class="names-en" lang="en">{t.en}</span>}</p>
        <Seam />
        <p class="def">{t.summary}</p>
        {t.scale?.avg && <p class="avg-inline"><b>{fmt(t.scale.avg.v, t.scale)}</b>{t.scale.avg.t}</p>}
        <p class="toggles order-row" role="group" aria-label="읽는 순서"><span class="toggles-label">읽는 순서</span><button type="button" data-order="easy" aria-pressed="true">쉽게 먼저</button><button type="button" data-order="deep" aria-pressed="false">깊게 먼저</button></p>
      </header>

      <div data-reading-order>
        <Sec title="쉽게 말하면" data-block="easy">{t.easy.map((p) => <p>{p}</p>)}</Sec>
        {t.scale && <Sec title="숫자 읽는 법" data-block="scale"><Scale scale={t.scale} /></Sec>}
        <Sec title="깊게 보면" data-block="deep">{t.formula && <Formula formula={t.formula} />}{t.deep.map((p) => <p>{p}</p>)}</Sec>
      </div>
  {/* 읽는 순서: 첫 화면이 그려지기 전에 저장된 순서로 바꿔 두려고 인라인으로 바로 실행한다. */}
  <script is:inline>
    (function () {
      var KEY = 'sh-order';
      var body = document.querySelector('[data-reading-order]');
      var buttons = document.querySelectorAll('[data-order]');
      function saved() {
        try { return localStorage.getItem(KEY) === 'deep'; } catch (e) { return false; }
      }
      function apply(deepFirst) {
        (deepFirst ? ['deep', 'scale', 'easy'] : ['easy', 'scale', 'deep']).forEach(function (k) {
          var el = body.querySelector('[data-block="' + k + '"]');
          if (el) body.appendChild(el);
        });
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', String((b.getAttribute('data-order') === 'deep') === deepFirst));
        });
      }
      if (saved()) apply(true);
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          var deepFirst = b.getAttribute('data-order') === 'deep';
          try { localStorage.setItem(KEY, deepFirst ? 'deep' : 'easy'); } catch (e) {}
          var y = window.scrollY;
          apply(deepFirst);
          window.scrollTo(0, y);
        });
      });
      window.addEventListener('pageshow', function (e) { if (e.persisted) apply(saved()); });
    })();
  </script>

      {t.myth && <Sec title="흔한 오해"><blockquote class="myth"><p>“{t.myth.claim}”</p></blockquote><p>{t.myth.truth}</p></Sec>}
      {t.leagues && t.leagues.length > 0 && (
        <Sec title="리그마다 다른 점">{t.leagues.map((l) => <p><b class="lg">{l.lg}</b>{l.t}</p>)}</Sec>
      )}
      {nexts.length > 0 && (
        <nav class="next-list" aria-label="사다리의 다음 용어">{nexts.map((n) => (
          <a class="next-row" href={n.href}><span class="next-label">다음 · 사다리 ‘{n.ladder}’</span><span class="next-name"><b>{n.name}</b><span>{n.sub}</span></span><span class="next-arrow" aria-hidden="true">→</span></a>
        ))}</nav>
      )}
    </article>

    <aside class="margin" aria-label="곁들여 볼 것">
      {t.scale?.avg && (
        <div class="mnote mnote-avg"><p class="mnote-title">평균</p><p class="avg-num">{fmt(t.scale.avg.v, t.scale)}</p><p class="mnote-small">{t.scale.avg.t}</p></div>
      )}
      {related.length > 0 && (
        <div class="mnote"><p class="mnote-title">같이 보기</p><ul class="see-also">{related.map((r) => (
          <li><a href={termHref(r.id)}>{r.chip}</a><span>{subName(r)}</span></li>
        ))}</ul></div>
      )}
    </aside>

    <Sec title="출처" class="endnotes"><ol class="sources">{t.sources.map((s) => <li><a href={s.u} target="_blank" rel="noopener">{s.t}</a></li>)}</ol></Sec>
  </div>
</Base>
