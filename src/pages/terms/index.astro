---
// 용어 전체 목록. 레벨별로 묶고 레벨·분야로 고를 수 있다(scripts/term-index.ts). 아래쪽 알약의 ‘용어’가 여기로 온다.
import Seam from '../../components/Seam.astro';
import TermIndex from '../../components/TermIndex.astro';
import Base from '../../layouts/Base.astro';
import { loadHandbook } from '../../lib/handbook.ts';
import { SITE_NAME } from '../../lib/site.ts';

const { terms } = await loadHandbook();
---
<Base title={`용어 | ${SITE_NAME}`} description={`세이버메트릭스 용어 ${terms.length}개를 입문·중급·심화로 나눈 목록.`} view="terms" tab="terms">
  <header class="page-head">
    <h1 class="page-title">용어</h1>
    <Seam />
    <p class="page-desc">{terms.length}개를 쉬운 것부터 모았어요.</p>
  </header>
  <TermIndex />
</Base>
