---
// 사다리 전체. 홈의 가로 선을 세로로 펴서 용어마다 풀이까지 적는다. 아래쪽 알약의 ‘사다리’가 여기로 온다.
import LadderLine from '../components/LadderLine.astro';
import Seam from '../components/Seam.astro';
import Base from '../layouts/Base.astro';
import { loadHandbook } from '../lib/handbook.ts';
import { SITE_NAME } from '../lib/site.ts';

const { ladders } = await loadHandbook();
---
<Base title={`사다리 | ${SITE_NAME}`} description={`같이 읽으면 좋은 야구 기록 용어를 쉬운 것부터 이은 사다리 ${ladders.length}개.`} view="ladders" tab="ladders">
  <header class="page-head">
    <h1 class="page-title">사다리</h1>
    <Seam />
    <p class="page-desc">같이 읽으면 좋은 용어를 쉬운 것부터 이었어요.</p>
  </header>
  <div class="ladder-grid ladder-grid-v">{ladders.map((l) => (
    <section class="ladder" aria-label={`사다리 ${l.name}`}><h2 class="ladder-name">{l.name}<span class="ladder-hint">{l.hint}</span></h2><LadderLine ladder={l} dir="v" /></section>
  ))}</div>
</Base>
