---
import Formula from '../../../components/Formula.astro';
import LadderLine from '../../../components/LadderLine.astro';
import Scale from '../../../components/Scale.astro';
import Seam from '../../../components/Seam.astro';
import Sec from '../../../components/Sec.astro';
import Base from '../../../layouts/Base.astro';
import { avgCaption, fmt } from '../../../lib/format.ts';
import { loadHandbook } from '../../../lib/handbook.ts';
import { fill, LANGS, ui, type Lang } from '../../../lib/i18n.ts';
import { ladderPlaces } from '../../../lib/ladder.ts';
import { paths } from '../../../lib/paths.ts';
import type { NextStop } from '../../../lib/stop.ts';

// 용어 그림: components/fig/terms/<id>.astro. 용어마다 그 지표를 가장 잘 보여 주는 방식으로 그린다(빌드 때 만드는 정적 SVG).
const figures = import.meta.glob<{ default: (props: { lang: Lang }) => unknown }>('../../../components/fig/terms/*.astro', { eager: true });

export async function getStaticPaths() {
  const { terms } = await loadHandbook('ko');
  return LANGS.flatMap((lang) => terms.map((t) => ({ params: { lang: lang === 'ko' ? undefined : lang, id: t.id }, props: { lang } })));
}

const { lang } = Astro.props as { lang: Lang };
const s = ui(lang);
const { termHref } = paths(lang);
const { termMap, ladders } = await loadHandbook(lang);
const t = termMap.get(Astro.params.id!)!;
const places = ladderPlaces(ladders, t.id);
// 주제(사다리)마다 바로 다음 용어. 폰에서는 첫 번째를 아래쪽 알약 위에, 넓은 화면에서는 모두 본문 끝에 둔다.
const nexts: NextStop[] = places.flatMap(({ ladder, pos }) => {
  const n = termMap.get(ladder.steps[pos] ?? '');
  return n ? [{ href: termHref(n.id), name: n.chip, sub: n.sub, ladder: ladder.name }] : [];
});
// 관련 용어에는 맨 위 주제 띠에 이미 보이는 용어를 다시 적지 않는다.
const inLadders = new Set(places.flatMap(({ ladder }) => ladder.steps));
const related = t.related.filter((id) => !inLadders.has(id)).map((id) => termMap.get(id)!);
// 한국어 화면의 표제어는 팬이 부르는 이름이라 한글일 때가 있다. 표제 글꼴(Big Shoulders)에는 한글이 없어 크기를 따로 맞춘다.
const hangulHead = /[가-힣]/.test(t.headword);
const Figure = figures[`../../../components/fig/terms/${t.id}.astro`]?.default;
---
<Base lang={lang} title={`${t.title} | ${s.siteName}`} description={t.summary} view="term" tab="terms" termId={t.id} next={nexts[0]}>
  {/* 책의 본문 단과 여백 단. 넓은 화면에서는 Tufte CSS처럼 평균·관련 용어를 오른쪽 여백에 적는다. 좁은 화면에서는 본문 다음, 출처 앞에 온다. */}
  <div class="leaf">
    <article class="text">
      {/* 맨 위: 이 용어가 들어 있는 주제(사다리). 지금 용어가 빨간 점이다. */}
      {places.map(({ ladder, pos, total }) => (
        <nav class="strip" aria-label={fill(s.strip, { name: ladder.name, pos, total })}>
          <p class="strip-label"><b>{ladder.name}</b><span>{pos} / {total}</span></p>
          <LadderLine lang={lang} ladder={ladder} dir="h" current={t.id} />
        </nav>
      ))}
      <header class="term-head">
        <p class="kicker"><span>{s.levels[t.level]}</span><span>{t.cats.map((c) => s.cats[c]).join(' · ')}</span>{t.added && <span>{fill(s.introduced, { year: t.added })}</span>}</p>
        <h1 class:list={['headword', { 'headword-hangul': hangulHead }]}>{t.headword}</h1>
        {(t.nameMain || t.nameAlt) && <p class="names">{t.nameMain && <span class="names-main">{t.nameMain}</span>}{t.nameAlt && <span class="names-alt">{t.nameAlt}</span>}</p>}
        <Seam />
        <p class="def">{t.summary}</p>
        {t.scale?.avg && <p class="avg-inline"><b>{fmt(t.scale.avg.v, t.scale)}</b>{avgCaption(t.scale.avg, t.scale)}</p>}
        {Figure && <Figure lang={lang} />}
        <p class="toggles order-row" role="group" aria-label={s.readingOrder}><button type="button" data-order="easy" aria-pressed="true">{s.easyFirst}</button><button type="button" data-order="deep" aria-pressed="false">{s.deepFirst}</button></p>
      </header>

      <div data-reading-order>
        <Sec title={s.easy} data-block="easy">{t.easy.map((p) => <p>{p}</p>)}</Sec>
        {t.scale && <Sec title={s.scale} data-block="scale"><Scale lang={lang} scale={t.scale} /></Sec>}
        <Sec title={s.deep} data-block="deep">{t.formula && <Formula formula={t.formula} />}{t.deep.map((p) => <p>{p}</p>)}</Sec>
      </div>
  {/* 읽는 순서: 첫 화면이 그려지기 전에 저장된 순서로 바꿔 두려고 인라인으로 바로 실행한다. */}
  <script is:inline>
    (function () {
      var KEY = 'sh-order';
      var body = document.querySelector('[data-reading-order]');
      var buttons = document.querySelectorAll('[data-order]');
      function saved() {
        try { return localStorage.getItem(KEY) === 'deep'; } catch (e) { return false; }
      }
      function apply(deepFirst) {
        (deepFirst ? ['deep', 'scale', 'easy'] : ['easy', 'scale', 'deep']).forEach(function (k) {
          var el = body.querySelector('[data-block="' + k + '"]');
          if (el) body.appendChild(el);
        });
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', String((b.getAttribute('data-order') === 'deep') === deepFirst));
        });
      }
      if (saved()) apply(true);
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          var deepFirst = b.getAttribute('data-order') === 'deep';
          try { localStorage.setItem(KEY, deepFirst ? 'deep' : 'easy'); } catch (e) {}
          var y = window.scrollY;
          apply(deepFirst);
          window.scrollTo(0, y);
        });
      });
      window.addEventListener('pageshow', function (e) { if (e.persisted) apply(saved()); });
    })();
  </script>

      {t.myth && <Sec title={s.myth}><blockquote class="myth"><p>“{t.myth.claim}”</p></blockquote><p>{t.myth.truth}</p></Sec>}
      {t.leagues && t.leagues.length > 0 && (
        <Sec title={s.leagues}>{t.leagues.map((l) => <p><b class="lg">{l.lg}</b>{l.t}</p>)}</Sec>
      )}
      {/* 본문 끝. 여기가 화면에 들어오고 10초가 지나면 읽은 용어로 적는다(scripts/progress.ts). */}
      <div data-read-mark aria-hidden="true"></div>
      {nexts.length > 0 && (
        <nav class="next-list" aria-label={s.nextTerms}>{nexts.map((n) => (
          <a class="next-row" href={n.href}><span class="next-label">{s.next} · {n.ladder}</span><span class="next-name"><b>{n.name}</b>{n.sub && <span>{n.sub}</span>}</span><span class="next-arrow" aria-hidden="true">→</span></a>
        ))}</nav>
      )}
    </article>

    <aside class="margin" aria-label={s.margin}>
      {t.scale?.avg && (
        <div class="mnote mnote-avg"><p class="mnote-title">{s.average}</p><p class="avg-num">{fmt(t.scale.avg.v, t.scale)}</p><p class="mnote-small">{avgCaption(t.scale.avg, t.scale)}</p></div>
      )}
      {related.length > 0 && (
        <div class="mnote"><p class="mnote-title">{s.related}</p><ul class="see-also">{related.map((r) => (
          <li><a href={termHref(r.id)}>{r.chip}</a>{r.sub && <span>{r.sub}</span>}</li>
        ))}</ul></div>
      )}
    </aside>

    <Sec title={s.sources} class="endnotes"><ol class="sources">{t.sources.map((s) => <li><a href={s.u} target="_blank" rel="noopener">{s.t}</a></li>)}</ol></Sec>
  </div>
</Base>
