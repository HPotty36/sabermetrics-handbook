---
import Chain from '../components/Chain.astro';
import LadderName from '../components/LadderName.astro';
import TermIndex from '../components/TermIndex.astro';
import Base from '../layouts/Base.astro';
import { hasHangul, loadHandbook, subName } from '../lib/handbook.ts';
import { termHref } from '../lib/paths.ts';
import { LEVELS } from '../lib/schema.ts';
import { SEASON, SITE_NAME } from '../lib/site.ts';

const { terms, stubs, ladders, termMap } = await loadHandbook();

// ‘처음이라면’ 입구는 OPS에서 시작한다.
const start = termMap.get('ops');
if (!start) throw new Error('홈 ‘처음이라면’ 입구의 시작 용어(terms/ops.json)가 없다');

const beginner = terms.filter((t) => t.level === 1);
// ‘이미 안다면’: 최근에 생긴 지표(작성된 것, 준비 중인 것) 다음에 심화 용어.
const byAddedDesc = (a: { added?: number }, b: { added?: number }) => b.added! - a.added!;
const recent = terms.filter((t) => t.added).sort(byAddedDesc);
const recentStubs = stubs.filter((s) => s.added).sort(byAddedDesc);
const deep = terms.filter((t) => t.level === 3 && !t.added);
---
<Base title={SITE_NAME} description="OPS, FIP, xwOBA 같은 야구 기록 용어를 쉬운 설명과 자세한 설명으로 나눠 정리한 한국어 용어 사전." view="home">
  <section class="intro">
    <h1>세이버메트릭스 용어 사전</h1>
    <p>야구 기록 용어 {terms.length}개를 ‘쉽게 말하면’과 ‘깊게 보면’ 두 겹으로 정리했어요. 리그 평균은 {SEASON} MLB 정규시즌 기준이에요.</p>
  </section>

  <div class="entries">
    <section class="entry">
      <h2>처음이라면</h2>
      <p>OPS부터 사다리 순서대로 읽으면 돼요.</p>
      <ul class="entry-list">{beginner.map((t) => (
        <li><a href={termHref(t.id)}><span class:list={['el-abbr', { 'is-ko': hasHangul(t.chip) }]}>{t.chip}</span><span class="el-name">{subName(t)}</span></a></li>
      ))}</ul>
      <a class="btn" href={termHref(start.id)}>OPS부터 읽기<span aria-hidden="true">→</span></a>
    </section>
    <section class="entry">
      <h2>이미 안다면</h2>
      <p>최근 Statcast에 생긴 지표와 심화 용어예요.</p>
      <ul class="entry-list">{recent.map((t) => (
        <li><a href={termHref(t.id)}><span class:list={['el-abbr', { 'is-ko': hasHangul(t.chip) }]}>{t.chip}</span><span class="el-name">{subName(t)}</span><span class="el-year">{t.added}</span></a></li>
      ))}{recentStubs.map((s) => (
        <li><span class="el-stub"><span class:list={['el-abbr', { 'is-ko': hasHangul(s.chip) }]}>{s.chip}</span><span class="el-name">준비 중</span><span class="el-year">{s.added}</span></span></li>
      ))}{deep.map((t) => (
        <li><a href={termHref(t.id)}><span class:list={['el-abbr', { 'is-ko': hasHangul(t.chip) }]}>{t.chip}</span><span class="el-name">{subName(t)}</span></a></li>
      ))}</ul>
    </section>
  </div>

  <section class="block">
    <div class="block-head">
      <h2>사다리</h2>
      <p>왼쪽이 기본이고, 오른쪽으로 갈수록 깊은 지표예요.</p>
      <p class="lv-legend">{([1, 2, 3] as const).map((l) => <span><span class={`dot dot${l}`} aria-hidden="true"></span>{LEVELS[l]}</span>)}</p>
    </div>
    <div class="ladders">{ladders.map((l) => (
      <div class="ladder"><LadderName ladder={l} /><Chain steps={l.steps} /></div>
    ))}</div>
  </section>

  <section class="block" id="home-index">
    <div class="block-head"><h2>전체 용어</h2></div>
    <TermIndex variant="grid" />
  </section>
</Base>
