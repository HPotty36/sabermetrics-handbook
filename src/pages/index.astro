---
import Chain from '../components/Chain.astro';
import LadderName from '../components/LadderName.astro';
import TermRow from '../components/TermRow.astro';
import Base from '../layouts/Base.astro';
import { loadHandbook } from '../lib/handbook.ts';
import { SEASON, SITE_NAME } from '../lib/site.ts';

const { terms, stubs, ladders, termMap } = await loadHandbook();

// ‘처음이라면’ 입구는 OPS에서 시작한다.
const start = termMap.get('ops');
if (!start) throw new Error('홈 ‘처음이라면’ 입구의 시작 용어(terms/ops.json)가 없다');

const beginner = [start, ...terms.filter((t) => t.level === 1 && t !== start)];
// ‘이미 안다면’: 최근에 생긴 지표(작성된 것, 준비 중인 것) 다음에 심화 용어.
const byAddedDesc = (a: { added?: number }, b: { added?: number }) => b.added! - a.added!;
const recent = terms.filter((t) => t.added).sort(byAddedDesc);
const recentStubs = stubs.filter((s) => s.added).sort(byAddedDesc);
const deep = terms.filter((t) => t.level === 3 && !t.added);
---
<Base title={SITE_NAME} description={`OPS, FIP, xwOBA 같은 야구 기록 용어 ${terms.length}개를 쉬운 설명과 자세한 설명으로 나눠 정리한 한국어 용어집.`} view="home">
  <h1 class="sr-only">{SITE_NAME}</h1>
  <div class="doors">
    <section class="door" aria-labelledby="door-first">
      <h2 id="door-first">처음이라면</h2>
      <p class="door-desc">중계 화면에 자주 나오는 숫자예요.</p>
      <ul class="rows">{beginner.map((t) => <li><TermRow term={t} /></li>)}</ul>
    </section>
    <section class="door" aria-labelledby="door-known">
      <h2 id="door-known">이미 안다면</h2>
      <p class="door-desc">최근 몇 년 사이 Statcast에 생긴 지표와 심화 용어예요.</p>
      <ul class="rows">{recent.map((t) => <li><TermRow term={t} note={`${t.added}년`} /></li>)}{recentStubs.map((s) => (
        <li><span class="row is-stub"><span class="row-head"><span class="row-name">{s.chip}</span><span class="row-note">{s.added}년</span></span><span class="row-sum">준비 중이에요.</span></span></li>
      ))}{deep.map((t) => <li><TermRow term={t} /></li>)}</ul>
    </section>
  </div>

  <section class="ladders" id="ladders" aria-labelledby="ladders-title">
    <h2 id="ladders-title">사다리</h2>
    <p class="door-desc">같이 읽으면 좋은 용어를 쉬운 것부터 이었어요.</p>
    {ladders.map((l) => (
      <div class="ladder"><LadderName ladder={l} /><Chain steps={l.steps} /></div>
    ))}
  </section>

  <p class="home-note">리그 평균은 {SEASON}년 MLB 정규시즌 기준이에요.</p>
</Base>
