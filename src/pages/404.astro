---
// 없는 주소. 이 파일이 있으면 Cloudflare Pages가 홈 대신 이 페이지를 404로 보낸다(예전에는 없는 주소도 홈이 200으로 나왔다).
// 어느 언어로 왔는지 알 수 없어 두 언어를 함께 적는다.
import Seam from '../components/Seam.astro';
import Base from '../layouts/Base.astro';
import { paths } from '../lib/paths.ts';

const ko = paths('ko');
const en = paths('en');
---
<Base lang="ko" title="페이지를 찾을 수 없어요 · Page not found | 세이버메트릭스 핸드북" description="찾는 페이지가 없어요." view="terms" tab="terms" notFound>
  <header class="page-head">
    <h1 class="page-title">페이지를 찾을 수 없어요</h1>
    <Seam />
  </header>
  <p class="notfound">주소가 바뀌었거나 없는 페이지예요. <a href={ko.homeHref}>홈</a>이나 <a href={ko.termsHref}>용어 목록</a>에서 찾아 보세요.</p>
  <p class="notfound" lang="en">This page doesn’t exist. Try the <a href={en.homeHref}>home page</a> or the <a href={en.termsHref}>list of terms</a>.</p>
</Base>
