---
// 모든 페이지의 틀. 맨 위 머리글은 두지 않는다.
// 넓은 화면: 왼쪽 단에 찾기, 메뉴(홈·주제·용어), 설정(언어, 다크 모드). 폰: 아래쪽에 떠 있는 알약(iOS 26 탭 막대처럼) 하나에 같은 메뉴와 찾기 단추,
// 설정은 화면 맨 위 오른쪽(iOS 큰 제목 화면의 오른쪽 위 단추 자리)에 둔다.
// 폰에서 찾기를 누르면 그 알약이 입력란 알약과 닫기 단추로 바뀐다(입력란은 왼쪽 단의 것을 그대로 쓴다).
// 용어 페이지에서는 알약 위에 주제(사다리)의 ‘다음’ 용어를 작은 알약으로 띄운다(iOS 26 탭 막대 위 액세서리).
// 글꼴은 npm 패키지로 사이트에서 직접 내보낸다. 오프라인(PWA)과 앱에서도 같은 글꼴로 보인다.
// 한글과 본문은 Pretendard(토스 같은 앱에서 흔히 쓰는 고딕), 표제·표제어·숫자는 Big Shoulders다.
// Pretendard는 유니코드 조각으로 나뉘어 있어 쓰는 글자의 조각만 받는다.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '@fontsource/big-shoulders-display/600';
import '@fontsource/big-shoulders-display/800';
import '../styles/global.css';
import SearchResults from '../components/SearchResults.astro';
import { loadHandbook } from '../lib/handbook.ts';
import { LANG_NAMES, otherLang, ui, type Lang } from '../lib/i18n.ts';
import { isAppBuild, paths } from '../lib/paths.ts';
import { APPLE_SPLASH, splashName } from '../lib/pwa.ts';
import { toSearchEntry } from '../lib/search.ts';
import type { NextStop } from '../lib/stop.ts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  view: 'home' | 'term' | 'ladders' | 'terms';
  /** 메뉴에서 칠할 곳. 용어 페이지는 ‘용어’에 속한다. */
  tab: 'home' | 'ladders' | 'terms';
  /** 용어 페이지의 용어 id. 다른 언어의 같은 페이지로 가는 링크에 쓴다. */
  termId?: string;
  /** 용어 페이지: 주제(사다리)의 다음 용어 */
  next?: NextStop;
}

const { lang, title, description, view, tab, termId, next } = Astro.props;
const s = ui(lang);
const p = paths(lang);
const { base } = p;
const { terms } = await loadHandbook(lang);
const searchIndex = JSON.stringify(terms.map((t) => toSearchEntry(t, p.termHref(t.id)))).replace(/</g, '\\u003c');

// 같은 페이지의 다른 언어. 언어 고르기와 <link rel="alternate">에 쓴다.
const hrefIn = (l: Lang) => {
  const q = paths(l);
  return { home: q.homeHref, ladders: q.laddersHref, terms: q.termsHref, term: q.termHref(termId ?? '') }[view];
};
const alt = otherLang(lang);
const altHref = hrefIn(alt);

// 메뉴. 지금 페이지면 aria-current="page", 용어 페이지에서 ‘용어’는 aria-current="true"(그 묶음 안에 있다는 뜻)다.
const menu = [
  { id: 'home', label: s.home, href: p.homeHref },
  { id: 'ladders', label: s.ladders, href: p.laddersHref },
  { id: 'terms', label: s.terms, href: p.termsHref },
] as const;
const current = (id: string) => (id !== tab ? undefined : view === 'term' ? 'true' : 'page');
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{/* 다크 모드: 첫 화면을 그리기 전에 저장된 선택(sh-theme)을 붙여 깜박이지 않게 한다. 고른 적이 없으면 기기 설정을 따른다. */}
<script is:inline>
  try { var t = localStorage.getItem('sh-theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
</script>
{lang === 'ko' && view === 'home' && (
  // 영어를 고른 사람이 밖에서(앱을 열거나, 주소를 쳐서) 한국어 홈에 들어오면 영어 홈으로 보낸다. 사이트 안에서 ‘한국어’를 눌러 온 것은 그대로 둔다.
  // 앱 아이콘의 바로 가기 ‘한국어’(?lang=ko)는 한국어를 고른 것으로 친다(manifest).
  <script is:inline define:vars={{ enHome: paths('en').homeHref }}>
    try {
      var fromSite = document.referrer && new URL(document.referrer).origin === location.origin;
      if (new URLSearchParams(location.search).get('lang') === 'ko') localStorage.setItem('sh-lang', 'ko');
      else if (localStorage.getItem('sh-lang') === 'en' && !fromSite) location.replace(enHome);
    } catch (e) {}
  </script>
)}
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#FBF9F4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`}>
{/* 홈 화면 웹앱(iOS): 이름, 독립 창, 상태 표시줄. 실행 화면 그림은 기기 크기마다 따로다(scripts/make-icons.mjs). */}
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content={s.appTitle}>
<meta name="apple-mobile-web-app-status-bar-style" content="default">
{APPLE_SPLASH.flatMap((d) => (['light', 'dark'] as const).map((mode) => (
  <link rel="apple-touch-startup-image" media={`screen and (device-width: ${d.w}px) and (device-height: ${d.h}px) and (-webkit-device-pixel-ratio: ${d.r}) and (orientation: portrait) and (prefers-color-scheme: ${mode})`} href={`${base}splash/${splashName(d, mode)}`}>
)))}
<link rel="manifest" href={lang === 'ko' ? `${base}manifest.webmanifest` : `${base}en/manifest.webmanifest`}>
<link rel="alternate" hreflang={lang} href={hrefIn(lang)}>
<link rel="alternate" hreflang={alt} href={altHref}>
</head>
<body data-view={view}>
<div class="page">
  <aside class="rail" aria-label={s.railLabel}>
    <div class="finder" role="search">
      <label class="finder-field"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><input id="q" type="search" autocomplete="off" enterkeyhint="go" placeholder={s.searchPlaceholder} aria-label={s.searchLabel} aria-controls="results"></label>
      <button type="button" class="finder-close glass" data-close-search aria-label={s.closeSearch}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></button>
    </div>
    <nav class="rail-nav" aria-label={s.menu}>{menu.map((m) => (
      <a href={m.href} aria-current={current(m.id)}>{m.label}</a>
    ))}</nav>
    {/* 설정: 같은 페이지의 다른 언어, 다크 모드(scripts/prefs.ts). 넓은 화면은 메뉴 아래, 폰은 화면 맨 위 오른쪽이다. */}
    <div class="prefs" role="group" aria-label={s.prefs}>
      <a class="pref-lang" href={altHref} hreflang={alt} lang={alt} data-lang-switch={alt}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3.4 12h17.2M12 3.4c2.5 2.4 3.8 5.3 3.8 8.6s-1.3 6.2-3.8 8.6c-2.5-2.4-3.8-5.3-3.8-8.6S9.5 5.8 12 3.4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>{LANG_NAMES[alt]}</a>
      <button type="button" class="pref-theme" data-theme-toggle aria-pressed="false"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M19.5 14.6A7.6 7.6 0 0 1 9.4 4.5a7.6 7.6 0 1 0 10.1 10.1z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="pref-theme-label">{s.darkMode}</span></button>
      {!isAppBuild && (
        // 설치(PWA): 설치할 수 있는 브라우저에서만 scripts/prefs.ts가 보인다. 앱(Capacitor)과 이미 설치한 화면에는 없다.
        <button type="button" class="pref-install" data-install hidden><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3.5v11M7.5 10l4.5 4.5 4.5-4.5M4.5 15.5v3.5h15v-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{s.install}</button>
      )}
    </div>
  </aside>
  {!isAppBuild && (
    // 설치 창을 띄울 수 없을 때(iOS, 아직 설치 이벤트가 오지 않은 안드로이드, 다른 앱 안의 브라우저) 방법을 아래쪽 시트로 알려 준다.
    // 셋 중 맞는 것 하나만 scripts/prefs.ts가 보인다.
    <dialog class="install-sheet glass" data-install-sheet>
      <div class="install-help" data-help="ios" hidden>
        <h2 id="install-title-ios">{s.installTitle}</h2>
        <ol>
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 14V3.5M8 7.5l4-4 4 4M8.5 10H6v10h12V10h-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{s.installShare}</li>
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 8.5v7M8.5 12h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>{s.installAdd}</li>
        </ol>
      </div>
      <div class="install-help" data-help="android" hidden>
        <h2 id="install-title-android">{s.installAndroidTitle}</h2>
        <ol>
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="5.5" r="1.7" fill="currentColor"/><circle cx="12" cy="12" r="1.7" fill="currentColor"/><circle cx="12" cy="18.5" r="1.7" fill="currentColor"/></svg>{s.installAndroidMenu}</li>
          <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3.5v11M7.5 10l4.5 4.5 4.5-4.5M4.5 15.5v3.5h15v-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{s.installAndroidAdd}</li>
        </ol>
        <p class="install-note">{s.installAndroidNote}</p>
      </div>
      <div class="install-help" data-help="inapp" hidden>
        <h2 id="install-title-inapp">{s.inAppTitle}</h2>
        <p>{s.inAppBody}</p>
        <p class="install-note" data-inapp-hint hidden>{s.inAppHint}</p>
      </div>
      <form method="dialog"><a class="install-open" data-install-open hidden>{s.inAppOpen}</a><button class="install-close">{s.close}</button></form>
    </dialog>
  )}
  <SearchResults lang={lang} />
  <main class="main" id="main"><slot /></main>
</div>

{/* 폰의 아래쪽 알약. 넓은 화면에서는 숨기고 왼쪽 단이 같은 일을 한다. */}
<div class="dock">
  {next && (
    <a class="dock-next glass" href={next.href}><span class="dock-next-label">{s.next}<span class="sr-only"> {s.term}, {next.ladder}</span></span><b>{next.name}</b>{next.sub && <span class="dock-next-sub">{next.sub}</span>}<span class="dock-next-arrow" aria-hidden="true">→</span></a>
  )}
  <div class="dock-row">
    <nav class="tabs glass" aria-label={s.menu}>{menu.map((m) => (
      <a class="tab" href={m.href} aria-current={current(m.id)}>
        {m.id === 'home' && <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 4.5h14v7.5l-7 7.5-7-7.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>}
        {m.id === 'ladders' && <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 6.5v11" stroke="currentColor" stroke-width="2.2"/><circle cx="12" cy="4.5" r="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="19.5" r="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>}
        {m.id === 'terms' && <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 6.5h11M9 12h11M9 17.5h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="4.75" cy="6.5" r="1.25" fill="currentColor"/><circle cx="4.75" cy="12" r="1.25" fill="currentColor"/><circle cx="4.75" cy="17.5" r="1.25" fill="currentColor"/></svg>}
        <span>{m.label}</span>
      </a>
    ))}</nav>
    <button type="button" class="tab-search glass" data-open-search aria-label={s.searchLabel} aria-controls="results"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
  </div>
</div>

<script type="application/json" id="search-index" is:inline set:html={searchIndex} />
<script>
  import '../scripts/search-box.ts';
  import '../scripts/term-index.ts';
  import '../scripts/prefs.ts';
</script>
{import.meta.env.PROD && !isAppBuild && (
  // 설치형 웹앱(PWA): 오프라인에서도 열리도록 서비스 워커를 등록한다.
  // 개발 서버에서는 캐시가 방해되고, 앱(Capacitor)은 파일이 기기 안에 있어 필요 없으므로 등록하지 않는다.
  <script is:inline define:vars={{ swUrl: `${base}sw.js`, scope: base }}>
    if ('serviceWorker' in navigator) {
      addEventListener('load', function () {
        var sw = navigator.serviceWorker;
        sw.register(swUrl, { scope: scope }).catch(function () {});
        // 나머지 페이지는 첫 화면과 브라우저의 설치 검사가 끝난 뒤에 저장하게 한다(sw-template.js의 warm).
        // 새 서비스 워커가 자리를 잡으면(controllerchange) 그 워커에 다시 알린다.
        function warm() {
          setTimeout(function () { sw.ready.then(function (r) { if (r.active) r.active.postMessage('warm'); }); }, 3000);
        }
        warm();
        sw.addEventListener('controllerchange', warm);
      });
    }
  </script>
)}
</body>
</html>
