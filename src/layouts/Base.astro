---
// 모든 페이지의 틀. 헤더(검색), 실밥 구분선, 데스크톱 사이드바 목록, 본문 열.
// 글꼴은 npm의 Fontsource 패키지로 사이트에서 직접 내보낸다. 오프라인(PWA)과 앱에서도 같은 글꼴로 보인다.
import '@fontsource/ibm-plex-sans-kr/400';
import '@fontsource/ibm-plex-sans-kr/500';
import '@fontsource/ibm-plex-sans-kr/600';
import '@fontsource/ibm-plex-sans-kr/700';
import '@fontsource/big-shoulders-display/600';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/ibm-plex-mono/400';
import '@fontsource/ibm-plex-mono/500';
import '../styles/global.css';
import Foot from '../components/Foot.astro';
import TermIndex from '../components/TermIndex.astro';
import { loadHandbook } from '../lib/handbook.ts';
import { base, homeHref, isAppBuild, termHref } from '../lib/paths.ts';
import { toSearchEntry } from '../lib/search.ts';

interface Props {
  title: string;
  description: string;
  view: 'home' | 'term';
  current?: string;
}

const { title, description, view, current } = Astro.props;
const { terms } = await loadHandbook();
const searchIndex = JSON.stringify(terms.map((t) => toSearchEntry(t, termHref(t.id)))).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#F2F4F7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0C111A" media="(prefers-color-scheme: dark)">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`}>
<link rel="manifest" href={`${base}manifest.webmanifest`}>
</head>
<body data-view={view}>
<header class="site-head">
  <div class="head-inner">
    <a class="brand" href={homeHref} aria-label="세이버메트릭스 핸드북 홈"><img src={`${base}favicon.svg`} width="22" height="22" alt=""><span>세이버<span class="long">메트릭스</span> 핸드북</span></a>
    <label class="search" for="q">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"/><path d="M13 13l5 5"/></svg>
      <input id="q" type="search" autocomplete="off" placeholder="FIP, 수비 무관, attack angle…" aria-label="용어 검색">
    </label>
  </div>
  <div class="stitch" aria-hidden="true"></div>
</header>

<div class="app">
  <aside class="side" aria-label="전체 용어">
    <div id="side-index"><TermIndex current={current} /></div>
  </aside>
  <main class="main" id="main"><slot /><Foot /></main>
</div>

<script type="application/json" id="search-index" is:inline set:html={searchIndex} />
<script>
  import '../scripts/term-index.ts';
</script>
{import.meta.env.PROD && !isAppBuild && (
  // 설치형 웹앱(PWA): 오프라인에서도 열리도록 서비스 워커를 등록한다.
  // 개발 서버에서는 캐시가 방해되고, 앱(Capacitor)은 파일이 기기 안에 있어 필요 없으므로 등록하지 않는다.
  <script is:inline define:vars={{ swUrl: `${base}sw.js`, scope: base }}>
    if ('serviceWorker' in navigator) {
      addEventListener('load', function () { navigator.serviceWorker.register(swUrl, { scope: scope }).catch(function () {}); });
    }
  </script>
)}
</body>
</html>
