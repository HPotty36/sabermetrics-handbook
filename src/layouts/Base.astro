---
// 모든 페이지의 틀. 머리글(검색), 검색 결과, 넓은 화면의 왼쪽 사다리 목록, 본문.
// 글꼴은 Pretendard 하나다. npm 패키지로 사이트에서 직접 내보내서 오프라인(PWA)과 앱에서도 같은 글꼴로 보인다.
// 유니코드 조각으로 나뉘어 있어 쓰는 글자의 조각만 받는다.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import LadderIndex from '../components/LadderIndex.astro';
import SearchResults from '../components/SearchResults.astro';
import { loadHandbook } from '../lib/handbook.ts';
import { base, homeHref, isAppBuild, termHref } from '../lib/paths.ts';
import { toSearchEntry } from '../lib/search.ts';

interface Props {
  title: string;
  description: string;
  view: 'home' | 'term';
  current?: string;
}

const { title, description, view, current } = Astro.props;
const { terms } = await loadHandbook();
const searchIndex = JSON.stringify(terms.map((t) => toSearchEntry(t, termHref(t.id)))).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`}>
<link rel="manifest" href={`${base}manifest.webmanifest`}>
</head>
<body data-view={view}>
<header class="top">
  <div class="top-inner">
    <a class="brand" href={homeHref} aria-label="세이버메트릭스 핸드북 처음으로"><img src={`${base}favicon.svg`} width="26" height="26" alt=""><span>세이버<span class="long">메트릭스</span> 핸드북</span></a>
    <div class="search" role="search">
      <svg class="search-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input id="q" type="search" autocomplete="off" enterkeyhint="go" placeholder="용어 찾기" aria-label="용어 찾기" aria-controls="results">
    </div>
  </div>
</header>

<SearchResults />
<div class="page">
  <aside class="side" aria-label="사다리"><p class="side-title">사다리</p><LadderIndex current={current} /></aside>
  <main class="main" id="main"><slot /></main>
</div>

<script type="application/json" id="search-index" is:inline set:html={searchIndex} />
<script>
  import '../scripts/search-box.ts';
</script>
{import.meta.env.PROD && !isAppBuild && (
  // 설치형 웹앱(PWA): 오프라인에서도 열리도록 서비스 워커를 등록한다.
  // 개발 서버에서는 캐시가 방해되고, 앱(Capacitor)은 파일이 기기 안에 있어 필요 없으므로 등록하지 않는다.
  <script is:inline define:vars={{ swUrl: `${base}sw.js`, scope: base }}>
    if ('serviceWorker' in navigator) {
      addEventListener('load', function () { navigator.serviceWorker.register(swUrl, { scope: scope }).catch(function () {}); });
    }
  </script>
)}
</body>
</html>
