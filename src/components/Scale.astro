---
// 숫자 눈금 막대. 평균은 홈플레이트 모양 마커로 표시한다.
import { fmt, pos } from '../lib/format.ts';
import { fill, ui, type Lang } from '../lib/i18n.ts';
import type { Scale } from '../lib/schema.ts';

interface Props {
  lang: Lang;
  scale: Scale;
}

const { lang, scale: s } = Astro.props;
const u = ui(lang);
const at = (v: number) => pos(v, s);
const bandStyle = s.band && `left:${at(s.band[0])}%;width:${(Number(at(s.band[1])) - Number(at(s.band[0]))).toFixed(2)}%`;
const legend = [...s.marks].sort((a, b) => a.v - b.v);
// Baseball Savant 퍼센타일 막대처럼 막대 양 끝에 ‘나쁨 · 좋음’을 적는다. 좋은 쪽을 진하게 쓴다.
const ends = { high: [u.worse, u.better], low: [u.better, u.worse], none: null }[s.dir];
const betterLabel = { high: u.higherBetter, low: u.lowerBetter, none: '' }[s.dir];
---
<div class="scale" role="img" aria-label={fill(u.scaleRange, { min: fmt(s.min, s), max: fmt(s.max, s) }) + betterLabel}>
  {ends && <div class="scale-ends">{ends.map((label) => <span class:list={{ good: label === u.better }}>{label}</span>)}</div>}
  <div class="scale-bar"><div class={`scale-track dir-${s.dir}`}>{bandStyle && <span class="scale-band" style={bandStyle}></span>}</div>{s.marks.map((m) => (
    <span class="tick" style={`left:${at(m.v)}%`}><span class="tick-num">{fmt(m.v, s)}</span></span>
  ))}{s.avg && (
    <span class="avg" style={`left:${at(s.avg.v)}%`}><span class="avg-tag">{u.avgTag}</span><span class="plate"></span></span>
  )}</div>
</div>
{/* 눈금 숫자의 뜻. 평균은 막대의 마커와 위쪽 평균 줄에 이미 있으므로 다시 적지 않는다. */}
<dl class="legend">{legend.map((m) => <div><dt>{fmt(m.v, s)}</dt><dd>{m.t}</dd></div>)}</dl>
{s.note && <p class="scale-note">{s.note}</p>}
