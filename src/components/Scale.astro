---
// 숫자 눈금. 가는 막대에 구간 눈금을 찍고 평균은 홈플레이트 모양 마커로 표시한다.
// 막대 양 끝에 ‘나쁨 · 좋음’을 적는다(Baseball Savant 퍼센타일 막대처럼). 아래 목록은 눈금 숫자의 뜻이다.
import { fmt, pos } from '../lib/format.ts';
import type { Scale } from '../lib/schema.ts';

interface Props {
  scale: Scale;
}

const { scale: s } = Astro.props;
const at = (v: number) => pos(v, s);
const bandStyle = s.band && `left:${at(s.band[0])}%;width:${(Number(at(s.band[1])) - Number(at(s.band[0]))).toFixed(2)}%`;
const marks = [...s.marks].sort((a, b) => a.v - b.v);
const ends = { high: ['나쁨', '좋음'], low: ['좋음', '나쁨'], none: null }[s.dir];
const betterLabel = { high: ', 클수록 좋음', low: ', 작을수록 좋음', none: '' }[s.dir];
---
<div class="gauge" role="img" aria-label={`눈금 ${fmt(s.min, s)}에서 ${fmt(s.max, s)}까지${betterLabel}`}>
  <div class="gauge-bar"><div class="gauge-track">{bandStyle && <span class="gauge-band" style={bandStyle}></span>}</div>{marks.map((m) => (
    <span class="gauge-tick" style={`left:${at(m.v)}%`}><span class="gauge-num">{fmt(m.v, s)}</span></span>
  ))}{s.avg && (
    <span class="gauge-avg" style={`left:${at(s.avg.v)}%`}><span class="gauge-avg-tag">평균</span><span class="plate"></span></span>
  )}</div>
  {ends && <div class="gauge-ends">{ends.map((label) => <span>{label}</span>)}</div>}
</div>
<dl class="key">{marks.map((m) => <div><dt>{fmt(m.v, s)}</dt><dd>{m.t}</dd></div>)}</dl>
{s.note && <p class="scale-note">{s.note}</p>}
