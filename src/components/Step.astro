---
// 사다리와 '같이 보면 좋은 용어'의 한 칸. 작성된 용어는 링크, 준비 중 용어는 점선 칸이다.
import { loadHandbook } from '../lib/handbook.ts';
import { termHref } from '../lib/paths.ts';

interface Props {
  id: string;
  current?: string;
}

const { id, current } = Astro.props;
const { termMap, stubMap } = await loadHandbook();
const term = termMap.get(id);
const stub = stubMap.get(id);
const isCurrent = id === current;
---
{term ? (
  <a class:list={['step', { current: isCurrent }]} href={termHref(id)} aria-current={isCurrent ? 'page' : undefined}><span class={`dot dot${term.level}`} aria-hidden="true"></span>{term.chip}</a>
) : (
  <span class="step stub" title="준비 중">{stub!.chip} <small>{stub!.added ? `${stub!.added} · ` : ''}준비 중</small></span>
)}
