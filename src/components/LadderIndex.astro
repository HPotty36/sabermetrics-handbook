---
// 넓은 화면 왼쪽 단의 용어 목록. 따로 차례를 두지 않고 사다리별로 묶는다(모든 용어가 사다리 하나 이상에 들어 있다).
import { loadHandbook } from '../lib/handbook.ts';
import { termHref } from '../lib/paths.ts';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const { ladders, termMap, stubMap } = await loadHandbook();
---
<nav class="lindex" aria-label="사다리별 용어">{ladders.map((l) => (
  <section class="lindex-group">
    <h2 class="lindex-name">{l.name}</h2>
    <ol class="lindex-steps">{l.steps.map((id) => {
      const t = termMap.get(id);
      return t ? (
        <li><a href={termHref(id)} aria-current={id === current ? 'page' : undefined}>{t.chip}</a></li>
      ) : (
        <li class="is-stub">{stubMap.get(id)!.chip}<span>준비 중</span></li>
      );
    })}</ol>
  </section>
))}</nav>
