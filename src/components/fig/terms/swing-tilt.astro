---
// 스윙 틸트: 공과 만나기 직전 40ms 동안 배트가 지나는 면이 땅과 이루는 각도. 0°는 평평, 90°는 골프 스윙.
import { arc, n, polar, wedge } from '../../../lib/fig.ts';
import type { Lang } from '../../../lib/i18n.ts';
import Fig from '../Fig.astro';

const { lang } = Astro.props as { lang: Lang };
// 투수 쪽에서 본 배트. 손이 위, 배트 머리가 아래로 기운다.
const C = [64, 44] as const;
const T = 32.3;
const [bx, by] = polar(C[0], C[1], 190, -T);
const [gx, gy] = polar(C[0], C[1], 150, -90);
const [wx, wy] = polar(C[0], C[1], 222, -36);
const ko = {
  alt: '투수 쪽에서 본 배트. 손에서 배트 머리로 가며 땅과 32° 기울어 있다. 0°는 땅과 나란한 스윙, 90°는 골프 스윙.',
  caption: '투수 쪽에서 본 배트. 공과 만나기 직전 40ms 동안 배트가 지나는 면이 땅과 이루는 각도다. 32°는 2026 MLB 평균이고, 시즌 평균으로는 20° 안팎부터 50° 안팎까지 있다(연한 띠). 좋고 나쁨이 아니라 스윙의 종류이고, 같은 타자도 높은 공에는 평평해지고 낮은 공에는 가팔라진다.',
  flat: '0° 평평', golf: '90° 골프 스윙', t: '32°', range: '20~50°', hands: '손', barrel: '배트 머리',
};
const en: typeof ko = {
  alt: 'A bat seen from the pitcher, sloping 32 degrees below level from the hands to the barrel. 0 is a level swing; 90 is a golf swing.',
  caption: 'A bat seen from the mound. Tilt is the angle between the ground and the plane the bat sweeps through in the last 40 ms before contact. 32° is the 2026 MLB average; season averages run from about 20° to about 50° (pale band). It is a kind of swing, not good or bad, and the same hitter gets flatter on high pitches and steeper on low ones.',
  flat: '0° level', golf: '90° golf swing', t: '32°', range: '20–50°', hands: 'Hands', barrel: 'Barrel',
};
const L = lang === 'ko' ? ko : en;
---
<Fig h={222} alt={L.alt} caption={L.caption}>
  <path class="fi-soft" d={wedge(C[0], C[1], 214, -50, -20)} />
  <text x={n(wx + 4)} y={n(wy + 4)} class="tx-red tx-s">{L.range}</text>
  <path class="ln ln-1 ln-muted ln-dash" d={`M${C[0]} ${C[1]}H346`} />
  <path class="ln ln-1 ln-muted ln-dash" d={`M${C[0]} ${C[1]}L${n(gx)} ${n(gy)}`} />
  <text x="346" y={C[1] - 8} text-anchor="end" class="tx-s">{L.flat}</text>
  <text x={n(gx + 8)} y={n(gy)} class="tx-s">{L.golf}</text>
  <path class="ln ln-red" d={arc(C[0], C[1], 70, -T, 0)} />
  <text x={C[0] + 78} y={C[1] + 26} class="tx-red tx-b tx-l">{L.t}</text>
  <path class="ln" style="stroke-width:7" d={`M${C[0]} ${C[1]}L${n(bx)} ${n(by)}`} />
  <circle class="fi-ink" cx={C[0]} cy={C[1]} r="6" />
  <text x={C[0]} y={C[1] - 14} text-anchor="middle" class="tx-ink tx-s">{L.hands}</text>
  <text x={n(bx + 10)} y={n(by + 5)} class="tx-ink tx-s">{L.barrel}</text>
</Fig>
