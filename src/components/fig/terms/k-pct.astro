---
// K%: 타석(투수는 상대한 타자) 가운데 삼진으로 끝난 비율.
import { paTotals, pct1 } from '../../../lib/fig.ts';
import type { Lang } from '../../../lib/i18n.ts';
import Fig from '../Fig.astro';
import PaLine from '../PaLine.astro';

const { lang } = Astro.props as { lang: Lang };
const t = paTotals();
const ko = {
  alt: `가상의 12타석 중 삼진 ${t.K}번. K% ${pct1(t.K / t.PA)}.`,
  caption: '가상의 12타석. 분모는 이닝이 아니라 타석이다. 투수라면 상대한 타자 12명으로 읽는다.',
  num: '삼진', den: '타석',
  calc: `삼진 ${t.K} ÷ 타석 ${t.PA} =`,
};
const en: typeof ko = {
  alt: `Of 12 hypothetical plate appearances, ${t.K} ended in a strikeout. K% ${pct1(t.K / t.PA)}.`,
  caption: 'Twelve made-up plate appearances. The denominator is plate appearances, not innings; for a pitcher, read it as 12 batters faced.',
  num: 'Strikeout', den: 'Plate appearance',
  calc: `${t.K} strikeouts ÷ ${t.PA} PA =`,
};
const L = lang === 'ko' ? ko : en;
---
<Fig h={236} alt={L.alt} caption={L.caption}>
  <PaLine lang={lang} state={(k) => (k === 'K' ? 'num' : 'den')} legend={{ num: L.num, den: L.den }} calc={L.calc} result={pct1(t.K / t.PA)} />
</Fig>
