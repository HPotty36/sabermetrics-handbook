---
// 블로킹: 땅에 꽂히는 공마다 폭투·포일이 될 확률을 매기고, 막아 낸 만큼(또는 빠뜨린 만큼) 기대치와의 차이를 센다.
import { n } from '../../../lib/fig.ts';
import type { Lang } from '../../../lib/i18n.ts';
import Fig from '../Fig.astro';

const { lang } = Astro.props as { lang: Lang };
const S = 4; // 1인치
const cx = 180;
const top = 22;
const bottom = top + 22 * S;
const ground = bottom + 18 * S;
const A = [cx - 4 * S, ground - 6];
const B = [cx + 15 * S, ground - 6];
const ko = {
  alt: '포수 앞 땅에 꽂히는 가상의 두 공. 빠질 확률 10%인 공은 막으면 +0.10, 빠뜨리면 −0.90. 빠질 확률 60%인 공은 막으면 +0.60, 빠뜨리면 −0.40.',
  caption: '포수 뒤에서 본 가상의 두 공. 퍼센트는 그 공이 폭투나 포일이 될 확률이다(가상의 예). 막으면 그 확률만큼 더하고, 빠뜨리면 1에서 그 확률을 뺀 만큼 뺀다. 그래서 홈 바로 앞에 떨어진 쉬운 공을 빠뜨리면 크게 깎이고, 멀리 옆으로 튄 어려운 공은 막으면 크게 얹힌다. 막아 낸 공 1개가 0.25점이다.',
  zone: '스트라이크 존', plate: '홈플레이트',
  a: '빠질 확률 10%', b: '빠질 확률 60%', block: '막으면', miss: '빠뜨리면',
};
const en: typeof ko = {
  alt: 'Two hypothetical pitches in the dirt. A pitch with a 10% chance of getting by is +0.10 if blocked and −0.90 if missed; a 60% pitch is +0.60 blocked and −0.40 missed.',
  caption: 'Two made-up pitches seen from behind the catcher. Each percentage is the chance that the pitch becomes a wild pitch or passed ball (made up). A block adds that chance; a miss subtracts one minus that chance. So missing an easy one that lands just in front of the plate costs a lot, and blocking a hard one that kicks far to the side earns a lot. One block above average is worth 0.25 runs.',
  zone: 'Strike zone', plate: 'Home plate',
  a: '10% to get by', b: '60% to get by', block: 'Blocked', miss: 'Missed',
};
const L = lang === 'ko' ? ko : en;
const rows = (x: number, y: number, anchor: 'start' | 'end', head: string, plus: string, minus: string, redMinus: boolean) => ({ x, y, anchor, head, plus, minus, redMinus });
const labels = [
  rows(A[0] - 14, A[1] - 44, 'end', L.a, '+0.10', '−0.90', true),
  rows(B[0] + 14, B[1] - 44, 'start', L.b, '+0.60', '−0.40', false),
];
---
<Fig h={226} alt={L.alt} caption={L.caption}>
  <rect class="fi-none ln ln-2" x={n(cx - 8.5 * S)} y={top} width={n(17 * S)} height={n(22 * S)} />
  <text x={n(cx + 8.5 * S + 6)} y={n(top + 10)} class="tx-s">{L.zone}</text>
  <path class="ln ln-grid" d={`M0 ${ground}H360`} />
  <path class="ln ln-2" d={`M${n(cx - 8.5 * S)} ${ground}H${n(cx + 8.5 * S)}`} />
  <text x={cx} y={ground + 18} text-anchor="middle" class="tx-s">{L.plate}</text>
  <circle class="fi-ink" cx={n(A[0])} cy={n(A[1])} r="5.8" />
  <circle class="fi-ink" cx={n(B[0])} cy={n(B[1])} r="5.8" />
  {labels.map((l) => (
    <g>
      <text x={n(l.x)} y={n(l.y)} text-anchor={l.anchor} class="tx-ink tx-b tx-s">{l.head}</text>
      <text x={n(l.x)} y={n(l.y + 18)} text-anchor={l.anchor} class="tx-s">{L.block} <tspan class="tx-num tx-ink">{l.plus}</tspan></text>
      <text x={n(l.x)} y={n(l.y + 36)} text-anchor={l.anchor} class="tx-s">{L.miss} <tspan class:list={['tx-num', l.redMinus ? 'tx-red tx-b' : 'tx-ink']}>{l.minus}</tspan></text>
    </g>
  ))}
</Fig>
