---
// BB%: 타석(투수는 상대한 타자) 가운데 볼넷으로 끝난 비율.
import { paTotals, pct1 } from '../../../lib/fig.ts';
import type { Lang } from '../../../lib/i18n.ts';
import Fig from '../Fig.astro';
import PaLine from '../PaLine.astro';

const { lang } = Astro.props as { lang: Lang };
const t = paTotals();
const ko = {
  alt: `가상의 12타석 중 볼넷 ${t.BB}번. BB% ${pct1(t.BB / t.PA)}.`,
  caption: '가상의 12타석. 분모는 모든 타석이다. 투수라면 상대한 타자 12명으로 읽는다. 몸에 맞는 공은 볼넷이 아니다.',
  num: '볼넷', den: '타석',
  calc: `볼넷 ${t.BB} ÷ 타석 ${t.PA} =`,
};
const en: typeof ko = {
  alt: `Of 12 hypothetical plate appearances, ${t.BB} ended in a walk. BB% ${pct1(t.BB / t.PA)}.`,
  caption: 'Twelve made-up plate appearances. The denominator is every plate appearance; for a pitcher, read it as 12 batters faced. A hit-by-pitch is not a walk.',
  num: 'Walk', den: 'Plate appearance',
  calc: `${t.BB} walk ÷ ${t.PA} PA =`,
};
const L = lang === 'ko' ? ko : en;
---
<Fig h={236} alt={L.alt} caption={L.caption}>
  <PaLine lang={lang} state={(k) => (k === 'BB' ? 'num' : 'den')} legend={{ num: L.num, den: L.den }} calc={L.calc} result={pct1(t.BB / t.PA)} />
</Fig>
