---
// IVB: 중력만 받았다면 떨어졌을 높이와 실제 높이의 차이. 회전이 공을 덜 떨어지게 한 만큼이다.
import { n, pitchHeight, pitchPath, PSIDE } from '../../../lib/fig.ts';
import type { Lang } from '../../../lib/i18n.ts';
import Fig from '../Fig.astro';
import PitchSide from '../PitchSide.astro';

const { lang } = Astro.props as { lang: Lang };
const { x, y } = PSIDE;
const X = x(60.5);
const yA = y(pitchHeight(60.5));
const yG = y(pitchHeight(60.5, true));
const ko = {
  alt: '옆에서 본 포심. 중력만 받았다면 점선처럼 떨어졌을 공이 회전 때문에 덜 떨어져 실선으로 들어온다. 그 차이가 IVB다.',
  caption: '옆에서 본 가상의 포심(높이는 실제보다 3배 키웠다). 점선은 회전 없이 중력만 받았을 때의 길이다. 역회전이 공을 덜 떨어지게 해서 홈에서 그만큼 높이 지난다. 포심 평균은 약 16인치(2024)였다. 중력까지 넣은 실제 낙차와는 다른 값이다.',
  rubber: '투수판', plate: '홈플레이트', act: '실제', grav: '중력만 받았다면', ivb: 'IVB',
};
const en: typeof ko = {
  alt: 'A four-seamer from the side. With gravity alone it would drop along the dashed line; spin keeps it up along the solid line. The gap is IVB.',
  caption: 'A made-up four-seamer seen from the side (height drawn 3× taller). The dashed line is the path with gravity and no spin. Backspin keeps the ball from dropping as much, so it crosses the plate that much higher. The four-seam average was about 16 inches (2024). It is not the same as total drop with gravity included.',
  rubber: 'Rubber', plate: 'Plate', act: 'Actual', grav: 'Gravity only', ivb: 'IVB',
};
const L = lang === 'ko' ? ko : en;
---
<Fig h={176} alt={L.alt} caption={L.caption}>
  <PitchSide rubber={L.rubber} plate={L.plate} />
  <path class="ln ln-muted ln-dash" d={pitchPath(true)} />
  <path class="ln ln-2" d={pitchPath()} />
  <circle class="fi-paper ln" cx={n(X)} cy={n(yA)} r="5" />
  <circle class="fi-paper ln ln-muted ln-dot" cx={n(X)} cy={n(yG)} r="5" />
  <path class="ln ln-red ln-2" d={`M${n(X - 12)} ${n(yA)}h-6V${n(yG)}h6`} />
  <text x={n(X - 24)} y={n((yA + yG) / 2 + 5)} text-anchor="end" class="tx-red tx-b tx-l">{L.ivb}</text>
  <text x={n(x(40))} y={n(y(pitchHeight(40)) - 10)} text-anchor="middle" class="tx-ink tx-s">{L.act}</text>
  <text x={n(x(36))} y={n(y(pitchHeight(36, true)) + 20)} text-anchor="middle" class="tx-s">{L.grav}</text>
</Fig>
