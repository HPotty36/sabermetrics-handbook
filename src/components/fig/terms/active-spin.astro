---
// 액티브 스핀: 회전축 가운데 날아가는 방향과 직각인 몫만 공을 휘게 한다. 위에서 본 회전축을 두 몫으로 나눈다.
import { arrow, n } from '../../../lib/fig.ts';
import type { Lang } from '../../../lib/i18n.ts';
import Fig from '../Fig.astro';

const { lang } = Astro.props as { lang: Lang };
const C = [116, 128] as const;
// 회전축이 날아가는 방향과 65° 벌어진 포심: 직각인 몫 = sin 65° ≈ 91%(2026 포심 가운데 값 90.5%와 비슷하다)
const TH = 65;
const R = 100;
const t = (TH * Math.PI) / 180;
const ax = C[0] + R * Math.sin(t);
const ay = C[1] - R * Math.cos(t);
const axis = arrow(C[0] - R * Math.sin(t) * 0.55, C[1] + R * Math.cos(t) * 0.55, ax, ay, 9);
const act = arrow(C[0], C[1], ax, C[1], 8);
const gyro = arrow(C[0], C[1], C[0], ay, 8);
const fly = arrow(14, 214, 14, 40, 9);
const pct = Math.round(Math.sin(t) * 100);
const ko = {
  alt: `위에서 본 공. 회전축이 날아가는 방향과 ${TH}° 벌어져 있으면 회전의 약 ${pct}%가 공을 휘게 한다.`,
  caption: `위에서 본 가상의 포심(회전축이 수평인 경우). 회전축을 날아가는 방향과 직각인 몫(빨강)과 같은 방향인 몫(점선)으로 나누면, 직각인 몫만 공을 휘게 한다. 축이 ${TH}° 벌어지면 약 ${pct}%다. 2026년 투수들의 가운데 값은 포심 90.5%, 슬라이더 31.7%였다. 슬라이더는 총알처럼 도는 몫이 커서 낮은 값이 그 구종다운 모양이다.`,
  fly: '날아가는 방향(홈 쪽)', axis: '회전축', act: `휘게 하는 몫 ${pct}%`, gyro: '총알처럼 도는 몫(자이로)', ball: '공',
};
const en: typeof ko = {
  alt: `A ball seen from above. With the spin axis ${TH}° away from the direction of flight, about ${pct}% of the spin moves the ball.`,
  caption: `A made-up four-seamer from above (with a level spin axis). Split the axis into the part at right angles to the flight (red) and the part along it (dashed): only the right-angle part moves the ball. At ${TH}° that is about ${pct}%. In 2026 the median pitcher was at 90.5% for four-seamers and 31.7% for sliders; a slider spins like a bullet, so a low value is what makes it a slider.`,
  fly: 'Direction of flight (to the plate)', axis: 'Spin axis', act: `Part that moves it ${pct}%`, gyro: 'Bullet-spin part (gyro)', ball: 'Ball',
};
const L = lang === 'ko' ? ko : en;
---
<Fig h={232} alt={L.alt} caption={L.caption}>
  <path class="ln ln-muted" d={fly.line} /><path class="fi-muted" d={fly.head} />
  <text x="22" y="56" class="tx-s">{L.fly}</text>
  <path class="ln ln-1 ln-muted ln-dot" d={`M${n(ax)} ${n(ay)}V${C[1]}M${n(ax)} ${n(ay)}H${C[0]}`} />
  <circle class="fi-paper ln" cx={C[0]} cy={C[1]} r="26" />
  <path class="ln ln-muted ln-dash ln-2" d={gyro.line} /><path class="fi-muted" d={gyro.head} />
  <path class="ln ln-red ln-3" d={act.line} /><path class="fi-red" d={act.head} />
  <path class="ln ln-2" d={axis.line} /><path class="fi-ink" d={axis.head} />
  <text x={n(ax + 8)} y={n(ay + 4)} class="tx-ink tx-b">{L.axis}</text>
  <text x={n(ax + 8)} y={n(C[1] + 5)} class="tx-red tx-b">{L.act}</text>
  <text x={C[0] + 6} y={n(ay - 8)} class="tx-s">{L.gyro}</text>
</Fig>
