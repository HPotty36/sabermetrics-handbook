---
// 수비율: 실책 없이 처리한 기회의 비율. 수비수가 닿지 못한 공은 기회로 세지 않는다.
import { arrow, n, polar } from '../../../lib/fig.ts';
import type { Lang } from '../../../lib/i18n.ts';
import Fig from '../Fig.astro';

const { lang } = Astro.props as { lang: Lang };
// 위에서 본 내야. 유격수는 2루와 3루 사이 뒤쪽에 선다. 한 공은 범위 안(닿았는데 놓침), 한 공은 범위 밖(2루 옆으로 빠짐).
const H = [180, 236] as const;
const P = (r: number, deg: number) => polar(H[0], H[1], r, deg);
const BASE = 80;
const b1 = P(BASE, 45);
const b2 = P(BASE * Math.SQRT2, 90);
const b3 = P(BASE, 135);
const [lx, ly] = P(172, 135);
const [rx, ry] = P(172, 45);
const SS = [140, 122] as const;
const RR = 38;
const A = [152, 142] as const;
const B = [198, 58] as const;
const a = arrow(H[0] - 2, H[1] - 8, A[0] + 2, A[1] + 8, 7);
const b = arrow(H[0] + 1, H[1] - 8, B[0], B[1] + 6, 7);
const base = ([x, y]: readonly [number, number]) => `M${n(x)} ${n(y - 4)}l4 4l-4 4l-4 -4z`;
const ko = {
  alt: '유격수에게 닿은 공을 놓치면 실책으로 수비율이 떨어지지만, 닿지 못한 공은 안타가 되어 수비율에 들지 않는다.',
  caption: '위에서 본 내야와 유격수가 닿을 수 있는 범위. 범위 안으로 온 공을 놓치면 실책이라 수비율이 떨어진다. 닿지도 못한 공은 안타가 될 뿐 수비율에는 아무 일도 없다. 그래서 범위가 좁은 수비수가 오히려 수비율이 좋아 보이기도 한다. 수비율 = (자살 + 보살) ÷ (자살 + 보살 + 실책).',
  ss: '유격수', reach: '닿을 수 있는 범위', a: '범위 안 · 놓침', a2: '실책 · 수비율에 든다', b: '닿지 못함 · 안타', b2: '수비율에 들지 않는다',
};
const en: typeof ko = {
  alt: 'A ball the shortstop reaches and boots is an error and lowers fielding percentage; a ball he never reaches is a hit and does not count at all.',
  caption: 'The infield from above, with the ground the shortstop can cover. Boot a ball hit within reach and it is an error, so fielding percentage drops. A ball he never reaches just becomes a hit and fielding percentage never notices, which is how a fielder with little range can look good by this number. FPCT = (putouts + assists) ÷ (putouts + assists + errors).',
  ss: 'Shortstop', reach: 'Range', a: 'In reach · booted', a2: 'Error · counts', b: 'Out of reach · hit', b2: 'Does not count',
};
const L = lang === 'ko' ? ko : en;
---
<Fig h={252} alt={L.alt} caption={L.caption}>
  <path class="ln ln-1" d={`M${n(lx)} ${n(ly)}L${H[0]} ${H[1]}L${n(rx)} ${n(ry)}`} />
  <path class="ln ln-1 ln-muted" d={`M${n(b1[0])} ${n(b1[1])}L${n(b2[0])} ${n(b2[1])}L${n(b3[0])} ${n(b3[1])}`} />
  {[b1, b2, b3].map((p) => <path class="fi-paper ln ln-1" d={base(p)} />)}
  <circle class="fi-none ln ln-muted ln-dash" cx={SS[0]} cy={SS[1]} r={RR} />
  <text x={SS[0] - RR - 6} y={SS[1] - RR + 4} text-anchor="end" class="tx-s tx-halo">{L.reach}</text>
  <path class="ln ln-red ln-2" d={a.line} /><path class="fi-red" d={a.head} />
  <path class="ln ln-2" d={b.line} /><path class="fi-ink" d={b.head} />
  <circle class="fi-paper ln ln-2" cx={SS[0]} cy={SS[1]} r="6" />
  <text x={SS[0]} y={SS[1] - 12} text-anchor="middle" class="tx-ink tx-s">{L.ss}</text>
  <text x={B[0] + 12} y={B[1] - 4} class="tx-ink tx-b tx-s">{L.b}</text>
  <text x={B[0] + 12} y={B[1] + 11} class="tx-s">{L.b2}</text>
  <text x="236" y="214" class="tx-red tx-b tx-s">{L.a}</text>
  <text x="236" y="229" class="tx-red tx-s">{L.a2}</text>
  <path class="fi-ink" d={`M${H[0]} ${H[1] - 6}l6 6l-6 6l-6 -6z`} />
</Fig>
