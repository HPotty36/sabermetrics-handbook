---
// 홈의 사다리 한 줄. 칸을 화살표로 잇는다. 준비 중 용어는 링크 없이 흐리게 둔다.
import { loadHandbook } from '../lib/handbook.ts';
import { termHref } from '../lib/paths.ts';

interface Props {
  steps: string[];
}

const { steps } = Astro.props;
const { termMap, stubMap } = await loadHandbook();
---
<p class="route">{steps.map((id, i) => {
  const term = termMap.get(id);
  return (
    <>{i > 0 && <span class="arr" aria-hidden="true">→</span>}{term ? (
      <a href={termHref(id)}>{term.chip}</a>
    ) : (
      <span class="stub">{stubMap.get(id)!.chip}(준비 중)</span>
    )}</>
  );
})}</p>
