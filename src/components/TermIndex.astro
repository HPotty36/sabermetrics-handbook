---
// 차례. 넓은 화면의 왼쪽 단에 들어간다(폰에서는 홈의 두 입구와 사다리가 이 역할을 한다).
// Butterick의 Practical Typography 차례처럼 굵은 묶음 제목(레벨) 아래에 용어를 글자로만 늘어놓는다.
// 이름은 다른 목록과 같이 chip(중계·팬이 쓰는 말)을 쓴다. 레벨·분야 고르기는 scripts/term-index.ts가 처리한다.
import { loadHandbook, subName } from '../lib/handbook.ts';
import { termHref } from '../lib/paths.ts';
import { CATS, LEVELS } from '../lib/schema.ts';
import { ALL_CATS } from '../lib/search.ts';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const { terms } = await loadHandbook();
const levels = [1, 2, 3] as const;
const levelFilters = [0, 1, 2, 3] as const;
const cats = [ALL_CATS, ...CATS];
---
<div data-term-index>
  <div class="filters">
    <p class="toggles" role="group" aria-label="레벨"><span class="toggles-label">레벨</span>{levelFilters.map((l) => (
      <button type="button" data-level={l} aria-pressed={l === 0 ? 'true' : 'false'}>{l ? LEVELS[l] : '전부'}</button>
    ))}</p>
    <p class="toggles" role="group" aria-label="분야"><span class="toggles-label">분야</span>{cats.map((c) => (
      <button type="button" data-cat={c} aria-pressed={c === ALL_CATS ? 'true' : 'false'}>{c === ALL_CATS ? '전부' : c}</button>
    ))}</p>
  </div>
  <ul class="rows toc">{levels.map((l) => (
    <>
      <li class="toc-group" data-group={l}>{LEVELS[l]}</li>
      {terms.filter((t) => t.level === l).map((t) => (
        <li data-id={t.id}><a class="toc-row" href={termHref(t.id)} aria-current={t.id === current ? 'page' : undefined}><span class="toc-abbr">{t.chip}</span><span class="toc-ko">{subName(t)}</span></a></li>
      ))}
    </>
  ))}</ul>
  <p class="empty" hidden></p>
</div>
